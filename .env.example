# Обязательные — без них бот не стартует (проверка в bot.py)
BOT_TOKEN=
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Хотя бы один из трёх AI-ключей обязателен.
# Порядок перебора в коде: OpenRouter → Cerebras → Groq.
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=

# Необязательное. Без него бот работает, просто не появится кнопка Mini App
# слева от поля ввода. Без /app на конце — бот допишет сам.
WEBAPP_URL=https://your-domain

# Оплата рублями (карта и СБП) через прямой API ЮKassa. Берутся в личном
# кабинете ЮKassa: Настройки → Магазин. Если пусто — кнопки «Картой» и
# «СБП» просто не показываются, оплата звёздами работает как обычно.
# Не забудь там же, в разделе HTTP-уведомлений, указать адрес вебхука:
#   https://<домен>/webhook/yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Только для локального docker-compose (в проде не нужен — там DATABASE_URL)
POSTGRES_PASSWORD=change_me
